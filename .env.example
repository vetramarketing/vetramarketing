# Future SERVER configuration only. These placeholders do not enable uploads.
# Add real values to .env.local or your deployment's secret environment settings.
# Never prefix API credentials with NEXT_PUBLIC_ or put them in browser storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Use a signed image-only preset with server-enforced size/format limits.
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_UPLOAD_FOLDER=vetra-marketing

# Optional LOCAL-ONLY Flash shipping gateway. See docs/SHIPPING.md.
# Keep disabled on public hosting. npm run dev/start bind the app to loopback.
# Credentials remain server-side; never use NEXT_PUBLIC_ for these values.
VETRA_LOCAL_SHIPPING_ENABLED=false
VETRA_LOCAL_SHIPPING_ORIGIN=http://127.0.0.1:3100
# Start with a Flash-issued training account. Production must be selected explicitly.
FLASH_API_MODE=training
FLASH_MCH_ID=
FLASH_API_KEY=
